{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-expirations",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/admin-migrate.js": {
      "includeFiles": "db/schema.sql"
    }
  }
}
